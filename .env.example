# Kopieer naar .env om waarden uit config/config.json te overschrijven.
# .env staat in .gitignore en wordt nooit gecommit.

# OLLAMA_URL=http://localhost:11434
# RELAY_MODEL=gemma4:12b

# Nodig voor de web_search/web_fetch tools (Fase 2). Zonder deze key draait
# Relay gewoon door als losse chat, zonder tools. Haal een key op via
# https://ollama.com/settings/keys — let op: hiermee verlaten je zoekopdrachten
# en opgevraagde URL's je machine richting ollama.com (zie README.md).
# OLLAMA_API_KEY=
